{
  "name": "@live-codes/dlang-wasm",
  "version": "0.1.0",
  "description": "Run D with one API, on the DMD compiler compiled to WebAssembly",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/live-codes/browser-d.git",
    "directory": "packages/dlang-wasm"
  },
  "homepage": "https://github.com/live-codes/browser-d/tree/main/packages/dlang-wasm#readme",
  "bugs": "https://github.com/live-codes/browser-d/issues",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "node": "./src/index.node.js",
      "browser": "./src/index.js",
      "default": "./src/index.js"
    },
    "./iife": "./dist/dlang-wasm.global.js"
  },
  "bin": {
    "dlang-wasm-copy-assets": "./bin/copy-assets.mjs"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "dist",
    "assets",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:iife": "node scripts/build-iife.mjs",
    "test": "node --experimental-wasm-exnref --test \"test/*.test.js\"",
    "prepack": "npm run build:iife",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "d",
    "dlang",
    "dmd",
    "wasm",
    "webassembly",
    "compiler",
    "playground"
  ]
}
